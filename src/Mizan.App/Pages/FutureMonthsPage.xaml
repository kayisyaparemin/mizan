<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Mizan.App.ViewModels"
             x:Class="Mizan.App.Pages.FutureMonthsPage"
             x:Name="PageRoot"
             Title="12 Dönem">
    <!-- Liste kendi içinde kaymaz: sayfanın tamamı tek bir yüzey olarak kayar.
         Bu yüzden CollectionView değil BindableLayout — bir CollectionView'ı
         ScrollView içine koymak yüksekliğini ölçemez hâle getirir. -->
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="14">
            <VerticalStackLayout Spacing="10">
                <Label Text="FİNANSAL GÖRÜNÜM" Style="{StaticResource Eyebrow}" />
                <Label Text="12 Dönem" Style="{StaticResource PageTitle}" />
                <Label Text="Önümüzdeki 12 dönemde finansal durumunun nasıl değişeceğini gör." Style="{StaticResource MutedText}" />
                <!-- Sapma uyarısı: projeksiyon checkpoint'e bağlı kalır (I16),
                     ama mevcut dönemde gözlenen sapmayı söylemek zorunda. -->
                <Border Padding="14"
                        IsVisible="{Binding HasDeviationNotice}"
                        BackgroundColor="{StaticResource WarningSurface}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding DeviationNoticeText}"
                               TextColor="{StaticResource WarningText}" />
                        <Button Text="Mevcut dönemi gör →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenCurrentPeriodCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14"
                        IsVisible="{Binding HasInterestSummary}"
                        BackgroundColor="{StaticResource SoftPink}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="12 Dönem Tahmini Faiz Yükü" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="5">
                            <Label Text="Kredi kartı" Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1" Text="{Binding TotalCreditCardInterest}" />
                            <Label Grid.Row="1" Text="Finansman açığı" Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding TotalDeficitInterest}" />
                            <Label Grid.Row="2" Text="Toplam tahmini faiz" FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="2" Grid.Column="1" Text="{Binding TotalInterestCost}" FontFamily="OpenSansSemibold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <!-- Kredi kapatma önerisi: her kredi için ufuktaki taksit günleri
                     denenir; önerilen gün hiçbir dönemde açık oluşturmaz ve
                     toplamda kazandırır. -->
                <Border Padding="14" IsVisible="{Binding HasLoanAdvice}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Kredi Kapatma" Style="{StaticResource SectionTitle}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding LoanAdvice}"
                                             Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout Spacing="4">
                                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                                        <Label Text="{Binding Title}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Text="{Binding Headline}"
                                               TextColor="{StaticResource WarningText}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding IsRecommended}"
                                                             Value="True">
                                                    <Setter Property="TextColor"
                                                            Value="{StaticResource PositiveText}" />
                                                    <Setter Property="FontFamily"
                                                            Value="OpenSansSemibold" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding Detail}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="12" />
                                        <Button Text="Simülatörde dene →"
                                                IsVisible="{Binding IsRecommended}"
                                                Style="{StaticResource LinkButton}"
                                                HorizontalOptions="Start"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FutureMonthsViewModel}}, Path=TryLoanClosureCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Text="Krediyi düzenle →"
                                                IsVisible="{Binding NeedsPrincipal}"
                                                Style="{StaticResource LinkButton}"
                                                HorizontalOptions="Start"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FutureMonthsViewModel}}, Path=EditLoansCommand}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Padding="14" IsVisible="{Binding HasProjection}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Ne zaman karşılayabilirim?" Style="{StaticResource SectionTitle}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Text="{Binding TargetAmount}" Placeholder="Hedef tutar" Keyboard="Numeric" />
                            <Button Grid.Column="1" Text="Hesapla" Command="{Binding FindTargetCommand}" />
                        </Grid>
                        <Label Text="{Binding TargetResult}" IsVisible="{Binding HasTargetResult}" />
                    </VerticalStackLayout>
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                <Label Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}" TextColor="{StaticResource Error}" />
            </VerticalStackLayout>

            <Border IsVisible="{Binding HasNoProjection}"
                    BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Henüz 12 dönemlik plan yok."
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource MutedText}" />
                    <Button Text="Finansal Yapıya Git"
                            Command="{Binding OpenCommitmentsCommand}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasProjection}"
                                 BindableLayout.ItemsSource="{Binding Periods}"
                                 Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Border>
                                <VerticalStackLayout Spacing="11">
                                    <!-- §9 PRIMARY: dönem ve o dönemin sonucu -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Period}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="17" />
                                            <Label Text="{Binding Assignment}" Style="{StaticResource MutedText}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1"
                                                             HorizontalOptions="End"
                                                             Spacing="1">
                                            <Label Text="Dönem sonu"
                                                   Style="{StaticResource MutedText}"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding EndingProjectedBalance}"
                                                   Style="{StaticResource SecondaryAmount}"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <!-- §9 SECONDARY: dönemin üç temel kalemi -->
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Gelir" Style="{StaticResource MutedText}" />
                                            <Label Grid.Column="1" Text="{Binding Income}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Zorunlu ödemeler" Style="{StaticResource MutedText}" />
                                            <Label Grid.Column="1" Text="{Binding Mandatory}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="Yaşam gideri" Style="{StaticResource MutedText}" />
                                            <Label Grid.Column="1" Text="{Binding Living}" />
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasCarryOverDeficit}">
                                            <Label Text="Önceki dönemden devreden açık"
                                                   TextColor="{StaticResource DeficitText}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding CarryOverDeficit}"
                                                   TextColor="{StaticResource DeficitText}"
                                                   FontFamily="OpenSansSemibold" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <FlexLayout Wrap="Wrap" Direction="Row">
                                        <Border Padding="9,4"
                                                Margin="0,0,6,5"
                                                IsVisible="{Binding HasBeforeSalaryWarning}"
                                                BackgroundColor="{StaticResource WarningSurface}">
                                            <Label Text="{Binding BeforeSalaryWarning}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource WarningText}" />
                                        </Border>
                                        <Border Padding="9,4"
                                                Margin="0,0,6,5"
                                                IsVisible="{Binding HasInterest}"
                                                BackgroundColor="{StaticResource InterestSurface}">
                                            <Label Text="{Binding TotalInterest, StringFormat='Faiz yükü: {0}'}"
                                                   FontSize="11"
                                                   TextColor="{StaticResource InterestText}" />
                                        </Border>
                                        <Border Padding="9,4"
                                                Margin="0,0,6,5"
                                                IsVisible="{Binding HasEstimatedPayment}"
                                                BackgroundColor="{StaticResource ProjectionSurface}">
                                            <Label Text="Tahmini kart ödemesi"
                                                   FontSize="11"
                                                   TextColor="{StaticResource ProjectionText}" />
                                        </Border>
                                        <Border Padding="9,4"
                                                Margin="0,0,6,5"
                                                IsVisible="{Binding HasUndeterminedPayment}"
                                                BackgroundColor="{StaticResource WarningSurface}">
                                            <Label Text="Kart ödemesi belirlenmedi"
                                                   FontSize="11"
                                                   TextColor="{StaticResource WarningText}" />
                                        </Border>
                                    </FlexLayout>
                                    <Button Text="Bu dönemin ödeme ayrıntısı →"
                                            AutomationId="btn-period-detail"
                                            Style="{StaticResource LinkButton}"
                                            HorizontalOptions="End"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FutureMonthsViewModel}}, Path=OpenPeriodDetailCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>
                            <!-- Android'de ScrollView içinde %100 güvenilir tıklama için yerel Button katmanı -->
                            <Button BackgroundColor="Transparent"
                                    BorderColor="Transparent"
                                    AutomationId="card-period-overlay"
                                    CornerRadius="8"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FutureMonthsViewModel}}, Path=OpenPeriodDetailCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
