<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mizan.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MizanVersion Condition="'$(MizanVersion)' == ''">0.1.0</MizanVersion>
    <MizanBuildNumber Condition="'$(MizanBuildNumber)' == ''">1</MizanBuildNumber>
    <MizanCommit Condition="'$(MizanCommit)' == ''">local</MizanCommit>
    <MizanDevBuild Condition="'$(MizanDevBuild)' == '' and '$(Configuration)' == 'Debug'">true</MizanDevBuild>
    <MizanDevBuild Condition="'$(MizanDevBuild)' == ''">false</MizanDevBuild>
    <ApplicationTitle Condition="'$(MizanDevBuild)' == 'true'">Mizan Dev</ApplicationTitle>
    <ApplicationTitle Condition="'$(MizanDevBuild)' != 'true'">Mizan</ApplicationTitle>
    <ApplicationId Condition="'$(MizanDevBuild)' == 'true'">com.coinflow.mobile.dev</ApplicationId>
    <ApplicationId Condition="'$(MizanDevBuild)' != 'true'">com.coinflow.mobile</ApplicationId>
    <ApplicationDisplayVersion>$(MizanVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>$(MizanBuildNumber)</ApplicationVersion>
    <DefineConstants Condition="'$(MizanDevBuild)' == 'true'">$(DefineConstants);MIZAN_DEV_BUILD</DefineConstants>
    <SupportedOSPlatformVersion>21.0</SupportedOSPlatformVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="MizanCommit" Value="$(MizanCommit)" />
    <AssemblyMetadata Include="MizanBuildNumber" Value="$(MizanBuildNumber)" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFFACF" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFACF" BaseSize="128,128" />
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mizan.Domain\Mizan.Domain.csproj" />
    <ProjectReference Include="..\Mizan.Application\Mizan.Application.csproj" />
    <ProjectReference Include="..\Mizan.Infrastructure\Mizan.Infrastructure.csproj" />
  </ItemGroup>
</Project>
