<?xml version="1.0" encoding="utf-8" ?>
<!-- Simülatör ve Finansal Yapı'nın ortak koşul formu. BindingContext bir
     ScenarioConditionForm'dur; ekleme/kaydetme butonu barındıran sayfada durur. -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Mizan.App.Controls"
             x:Class="Mizan.App.Controls.ScenarioConditionFormView"
             x:Name="Root">
    <VerticalStackLayout Spacing="9">
        <!-- 13 türlük tek Picker yerine: önce grup, sonra en fazla üç
             açıklamalı tür kartı. Finansal Yapı türü kendi seçicisinde
             seçer; orada bu bölüm gizlidir. -->
        <VerticalStackLayout IsVisible="{Binding ShowsTypePicker}" Spacing="9">
            <Label Text="Plan türü" Style="{StaticResource FieldLabel}" />
            <controls:EntryTypePickerView />
        </VerticalStackLayout>

        <Label Text="{Binding ScenarioDescription}" Style="{StaticResource MutedText}" />
        <Label Text="Plan adı" Style="{StaticResource FieldLabel}" />
        <Entry Text="{Binding Name}" Placeholder="{Binding NamePlaceholder}" />
        <VerticalStackLayout IsVisible="{Binding IsLoanPrepayment}" Spacing="7">
            <Label Text="Kredi" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding Loans}"
                    SelectedItem="{Binding SelectedLoan}"
                    Title="Kredi seç" />
            <Label Text="Kayıtlı aktif kredi bulunamadı. Erken ödeme yapmak için önce bir kredi eklemelisin."
                   Style="{StaticResource MutedText}"
                   TextColor="{StaticResource Error}"
                   IsVisible="{Binding HasNoLoans}" />
            <Label Text="Ödeme şekli" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding PrepaymentModes}"
                    SelectedItem="{Binding SelectedPrepaymentMode}" />
        </VerticalStackLayout>
        <VerticalStackLayout IsVisible="{Binding IsRegularScenario}" Spacing="7">
            <VerticalStackLayout IsVisible="{Binding NeedsAmount}" Spacing="7">
                <Label Text="{Binding AmountLabel}" Style="{StaticResource FieldLabel}" />
                <Entry Text="{Binding Amount}" Placeholder="Örn. 25.000" Keyboard="Numeric" />
            </VerticalStackLayout>
            <Label Text="{Binding StartDateLabel}" Style="{StaticResource FieldLabel}" />
            <DatePicker Date="{Binding StartDate}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding IsStrategyChange}" Spacing="7">
            <Label Text="Yeni düzen" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding StrategyModes}"
                    SelectedItem="{Binding SelectedStrategyMode}" />
            <Label Text="Geçerli olacağı dönem" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding StrategySalaryDates}"
                    SelectedItem="{Binding SelectedStrategySalaryDate}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding IsCard}" Spacing="7">
            <Label Text="Kredi kartı" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CreditCards}" SelectedItem="{Binding SelectedCreditCard}" Title="Kart seç" />
            <Label Text="Kayıtlı kredi kartı bulunamadı. Kartla harcama girmek için önce bir kredi kartı eklemelisin."
                   Style="{StaticResource MutedText}"
                   TextColor="{StaticResource Error}"
                   IsVisible="{Binding HasNoCreditCards}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding IsCardPayoff}" Spacing="7">
            <Label Text="Ödeme şekli" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CardPaymentModes}"
                    SelectedItem="{Binding SelectedCardPaymentMode}" />
            <Label Text="Kapsam" Style="{StaticResource FieldLabel}" />
            <Picker ItemsSource="{Binding CardPaymentScopes}"
                    SelectedItem="{Binding SelectedCardPaymentScope}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding NeedsPaymentCount}" Spacing="7">
            <Label Text="{Binding PaymentCountLabel}" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding PaymentCount}" Placeholder="{Binding PaymentCountPlaceholder}" Keyboard="Numeric" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding NeedsFirstPayment}" Spacing="7">
            <Label Text="İlk ödeme tarihi" Style="{StaticResource FieldLabel}" />
            <DatePicker Date="{Binding FirstPaymentDate}" />
        </VerticalStackLayout>

        <VerticalStackLayout IsVisible="{Binding IsFinancing}" Spacing="7">
            <Label Text="Toplam geri ödeme" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding TotalRepaymentAmount}" Placeholder="Faiz dahil toplam, örn. 30.000" Keyboard="Numeric" />
        </VerticalStackLayout>
    </VerticalStackLayout>
</ContentView>
