<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CoinFlow.App.Pages.CardControlPage"
             Title="Kart">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="KREDİ KARTI" Style="{StaticResource Eyebrow}" />
                <Label Text="{Binding Title}"
                       Style="{StaticResource PageTitle}" />
                <Label Text="{Binding Subtitle}" Style="{StaticResource MutedText}" />
            </VerticalStackLayout>

            <Border BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="7">
                        <Label Text="Toplam bilinen borç" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1" Text="{Binding KnownDebt}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1" Text="Limit" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding LimitText}" FontFamily="OpenSansSemibold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kesilmiş Ekstre"
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding StatementText}"
                           FontSize="22"
                           FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                        <Label Text="Kesim" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1" Text="{Binding StatementDateText}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1" Text="Son ödeme" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding StatementDueText}" FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="2" Text="Asgari" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding StatementMinimumText}" FontFamily="OpenSansSemibold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Ekstreden İçeri Aktar"
                                Command="{Binding ImportStatementCommand}"
                                IsEnabled="{Binding CanInteract}" />
                        <Button Grid.Column="1"
                                Text="Elle Gir"
                                Command="{Binding StartManualStatementCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <HorizontalStackLayout Spacing="8"
                                           IsVisible="{Binding IsBusy}">
                        <ActivityIndicator IsRunning="{Binding IsBusy}" />
                        <Label Text="{Binding BusyMessage}"
                               VerticalTextAlignment="Center"
                               Style="{StaticResource MutedText}" />
                    </HorizontalStackLayout>
                    <Label Text="Kesilmiş ekstre yoksa eski başlangıç bilgileriyle hesaplama sürer."
                           Style="{StaticResource MutedText}"
                           IsVisible="{Binding HasNoActualStatement}" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasStatementDraft}"
                    BackgroundColor="{StaticResource SoftPink}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding StatementDraftTitle}"
                           Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Kart" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1"
                               Text="{Binding StatementDraftBank}"
                               FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1"
                               Text="Kart no"
                               Style="{StaticResource MutedText}"
                               IsVisible="{Binding HasStatementDraftLast4}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding StatementDraftLast4}"
                               IsVisible="{Binding HasStatementDraftLast4}"
                               FontFamily="OpenSansSemibold" />
                    </Grid>
                    <Label Text="{Binding StatementDraftDuplicate}"
                           IsVisible="{Binding IsStatementDraftDuplicate}"
                           TextColor="{StaticResource Error}" />
                    <Label Text="{Binding StatementDraftWarnings}"
                           IsVisible="{Binding HasStatementDraftWarnings}"
                           TextColor="{StaticResource Error}" />

                    <Label Text="Ekstre tutarı" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding StatementDraftAmount}" Keyboard="Numeric" />
                    <Label Text="Asgari ödeme" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding StatementDraftMinimum}" Keyboard="Numeric" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Kesim tarihi" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding StatementDraftDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Son ödeme" Style="{StaticResource FieldLabel}" />
                            <DatePicker Date="{Binding StatementDraftDueDate}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Sonraki tahmini kesim" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding StatementDraftNextStatementDate}"
                                   FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="6">
                            <Label Text="Sonraki tahmini son ödeme" Style="{StaticResource FieldLabel}" />
                            <Label Text="{Binding StatementDraftNextDueDate}"
                                   FontFamily="OpenSansSemibold" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label Text="Bu ekstreyi nasıl ödemeyi planlıyorsun?"
                           Style="{StaticResource FieldLabel}" />
                    <Label Text="{Binding StatementDraftPaymentPlanText}"
                           FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Text="Asgari"
                                Command="{Binding DraftPayMinimumCommand}" />
                        <Button Grid.Column="1"
                                Text="Tamamı"
                                Command="{Binding DraftPayFullCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="2"
                                Text="Başka Tutar"
                                Command="{Binding DraftPayCustomCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <Entry Text="{Binding StatementDraftCustomAmount}"
                           IsVisible="{Binding IsStatementDraftCustom}"
                           Placeholder="Özel ödeme tutarı"
                           Keyboard="Numeric" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Ekstreyi Kaydet"
                                Command="{Binding SaveStatementDraftCommand}"
                                IsEnabled="{Binding CanInteract}" />
                        <Button Grid.Column="1"
                                Text="Vazgeç"
                                Command="{Binding CancelStatementDraftCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding HasActualStatement}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Bu Ekstreyi Nasıl Ödeyeceksin?"
                           Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Plan" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1"
                               Text="{Binding CurrentStatementPlanText}"
                               FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1" Text="Ödenecek" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding CurrentStatementPaymentText}"
                               FontFamily="OpenSansSemibold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <Button Text="Asgari"
                                Command="{Binding SetCurrentStatementMinimumCommand}" />
                        <Button Grid.Column="1"
                                Text="Tamamı"
                                Command="{Binding SetCurrentStatementFullCommand}"
                                Style="{StaticResource SecondaryButton}" />
                        <Button Grid.Column="2"
                                Text="Başka"
                                Command="{Binding ShowCurrentStatementCustomCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="8"
                          IsVisible="{Binding IsCurrentStatementCustom}">
                        <Entry Text="{Binding CurrentStatementCustomAmount}"
                               Placeholder="Özel tutar"
                               Keyboard="Numeric" />
                        <Button Grid.Column="1"
                                Text="Kaydet"
                                Command="{Binding SaveCurrentStatementCustomCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SoftPink}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Sonraki Ekstre"
                           Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                        <Label Text="Tahmini" Style="{StaticResource MutedText}" />
                        <Label Grid.Column="1"
                               Text="{Binding NextStatementEstimateText}"
                               FontFamily="OpenSansSemibold" />
                        <Label Grid.Row="1" Text="Kesim" Style="{StaticResource MutedText}" />
                        <Label Grid.Row="1"
                               Grid.Column="1"
                               Text="{Binding NextStatementDateText}"
                               FontFamily="OpenSansSemibold" />
                    </Grid>
                    <Label Text="{Binding NextStatementBreakdownText}"
                           Style="{StaticResource MutedText}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Gelecek Kart Hareketleri"
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="Açıklama" Style="{StaticResource FieldLabel}" />
                    <Entry Text="{Binding ChargeDescription}"
                           Placeholder="Gelecek taksit" />
                    <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6">
                        <DatePicker Date="{Binding ChargeDate}" />
                        <Entry Grid.Column="1"
                               Text="{Binding ChargeAmount}"
                               Placeholder="Tutar"
                               Keyboard="Numeric" />
                        <Button Grid.Column="2"
                                Text="Ekle"
                                Command="{Binding AddChargeCommand}" />
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding FutureCharges}"
                                         IsVisible="{Binding HasFutureCharges}"
                                         Spacing="7">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      RowDefinitions="Auto,Auto"
                                      Padding="8">
                                    <Label Text="{Binding DateText}" />
                                    <Label Grid.Column="1"
                                           Text="{Binding AmountText}"
                                           FontFamily="OpenSansSemibold" />
                                    <Button Grid.Column="2"
                                            Text="Sil"
                                            CommandParameter="{Binding .}"
                                            Clicked="OnRemoveChargeClicked"
                                            MinimumHeightRequest="36"
                                            Padding="10,4" />
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           IsVisible="{Binding HasDescription}"
                                           Style="{StaticResource MutedText}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="Harcamaları Kaydet"
                            Command="{Binding SaveChargesCommand}" />
                </VerticalStackLayout>
            </Border>

            <Border>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Varsayılan Plan"
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="Gelecekteki ekstreleri genelde nasıl ödeyelim?"
                           Style="{StaticResource MutedText}" />
                    <Label Text="{Binding PaymentPreferenceText}"
                           FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Asgari"
                                Command="{Binding PayMinimumCommand}" />
                        <Button Grid.Column="1"
                                Text="Tamamı"
                                Command="{Binding PayFullCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                    <Button Text="Her Ekstrede Sor"
                            Command="{Binding AskEachStatementCommand}"
                            BackgroundColor="{StaticResource SoftPink}" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SoftSky}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Kararsız Gelecek Ekstrelerde"
                           Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding FallbackText}"
                           FontFamily="OpenSansSemibold" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="Asgari"
                                Command="{Binding FallbackMinimumCommand}" />
                        <Button Grid.Column="1"
                                Text="Tamamı"
                                Command="{Binding FallbackFullCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Button Text="Kart Bilgilerini Düzenle"
                    Command="{Binding OpenCardDetailsCommand}"
                    Style="{StaticResource SecondaryButton}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding BusyMessage}"
                   IsVisible="{Binding IsBusy}"
                   HorizontalTextAlignment="Center"
                   Style="{StaticResource MutedText}" />
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{StaticResource Error}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
