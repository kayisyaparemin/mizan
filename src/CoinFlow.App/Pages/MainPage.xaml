<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CoinFlow.App.Controls"
             xmlns:models="clr-namespace:CoinFlow.App.Models"
             xmlns:vm="clr-namespace:CoinFlow.App.ViewModels"
             x:Class="CoinFlow.App.Pages.MainPage"
             x:DataType="vm:DashboardViewModel"
             x:Name="PageRoot"
             Title="Ana Sayfa">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="14">

            <!-- Başlık -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="PLANLA • SİMÜLE ET • KARAR VER"
                           Style="{StaticResource Eyebrow}" />
                    <Label Text="Ana Sayfa" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Ayarlar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Padding="14,8"
                        MinimumHeightRequest="42"
                        VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- §11 UYARILAR — yalnız gerçekten gerekliyse -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding HasAlerts}"
                                 BindableLayout.ItemsSource="{Binding Alerts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardAlert">
                        <Border Style="{StaticResource AlertInfoSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAction}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource DeficitSurface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAttention}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource WarningSurface}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="7">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource AlertTitle}" />
                                <Label Text="{Binding Message}"
                                       Style="{StaticResource AlertBody}" />
                                <Button Text="{Binding ActionText}"
                                        IsVisible="{Binding HasAction}"
                                        Command="{Binding Action}"
                                        HorizontalOptions="Start"
                                        Padding="16,10"
                                        MinimumHeightRequest="44" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- §12 BOŞ DURUM -->
            <Border IsVisible="{Binding IsEmptyState}"
                    BackgroundColor="{StaticResource SoftSky}"
                    StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mizan'a hoş geldin"
                           Style="{StaticResource EmptyStateTitle}" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource EmptyStateBody}" />
                    <Button Text="{Binding EmptyStateAction}"
                            Command="{Binding OpenEmptyStateCommand}"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasFinancialPlan}"
                                 Spacing="14">

                <!-- İlk iş: t anındaki bakiye. İleriye dönük parametreler bir
                     kez girildikten sonra planı değiştiren tek şey bu; uygulamayı
                     açan kişi işe onu güncelleyerek başlamalı. Güncellemek
                     rakamla birlikte çapayı da bugüne taşır — "bugün şu kadar
                     param var" tek bir cümledir, ikisi ayrılamaz. -->
                <Border BackgroundColor="{StaticResource SoftSky}"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mevcut tutar"
                               Style="{StaticResource CardHeading}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Text="{Binding CurrentBalanceInput}"
                                   Keyboard="Numeric"
                                   controls:SignedNumericEntry.AllowNegative="True" />
                            <Button Grid.Column="1"
                                    Text="Güncelle"
                                    Padding="16,10"
                                    MinimumHeightRequest="44"
                                    IsEnabled="{Binding CanSaveCurrentBalance}"
                                    Command="{Binding SaveCurrentBalanceCommand}" />
                        </Grid>
                        <Label Text="{Binding CurrentSnapshotDate, StringFormat='Son güncelleme: {0}'}"
                               Style="{StaticResource MutedText}" />
                        <Label Text="Güncellediğinde plan bugünden itibaren yeniden kurulur; bu tarihten önceki hareketler gelecek planına girmez."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ PRIMARY ============ -->
                <Border BackgroundColor="{StaticResource HeroSurface}"
                        StrokeThickness="0"
                        Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding CurrentPeriodText}"
                               Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding HeadlineAmount}"
                               Style="{StaticResource PrimaryAmount}" />
                        <Label Text="{Binding HeadlineCaption}"
                               Style="{StaticResource PrimaryCaption}" />
                        <BoxView HeightRequest="1"
                                 Color="{StaticResource Line}"
                                 Margin="0,6" />
                        <Label Text="{Binding PeriodVerdict}"
                               Style="{StaticResource AlertBody}" />
                        <Label Text="{Binding CarryOverMessage}"
                               IsVisible="{Binding HasCarryOverDeficit}"
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- "Bu dönem nasıl oluşuyor" tablosu buradan kalktı: dönem
                     sonu rakamını yukarıdaki özet zaten söylüyordu, kırılımın
                     tamamı ise Dönem Detayı'nda daha ayrıntılı duruyor. -->
                <Button Text="Bu dönem nasıl oluşuyor →"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenCurrentPeriodDetailCommand}" />


                <!-- ============ SECONDARY ============ -->

                <!-- Yaklaşan ödemeler: her zaman görünür, tıklamaya gerek yok -->
                <Border>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Yaklaşan ödemeler"
                               Style="{StaticResource CardHeading}" />

                        <VerticalStackLayout Spacing="4"
                                             IsVisible="{Binding HasNoUpcomingPayments}">
                            <Label Text="Yaklaşan planlı ödemen yok."
                                   Style="{StaticResource EmptyStateBody}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PreFirstSalaryPayments}"
                                             IsVisible="{Binding HasPreFirstSalaryPayments}"
                                             Spacing="9">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UpcomingPaymentLine">
                                    <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding Date}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding Name}" />
                                        <Label Grid.Column="2" Text="{Binding Amount}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingPayments}"
                                             IsVisible="{Binding HasUpcomingPayments}"
                                             Spacing="9">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:UpcomingPaymentLine">
                                    <Grid ColumnDefinitions="64,*,Auto" RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding Date}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding Name}" />
                                        <Label Grid.Column="2" Text="{Binding Amount}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Button Text="Tüm yükümlülüklerim →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenCommitmentsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 12 dönem görünümü -->
                <Border BackgroundColor="{StaticResource SoftSky}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Önümüzdeki 12 dönem"
                               Style="{StaticResource CardHeading}" />
                        <Label Text="{Binding TwelveMonthSavings}"
                               Style="{StaticResource SecondaryAmount}" />
                        <Label Text="{Binding TwelveMonthCaption}"
                               Style="{StaticResource MutedText}" />
                        <Label Text="{Binding TightestPeriod}"
                               Style="{StaticResource MutedText}" />
                        <VerticalStackLayout Spacing="6"
                                             IsVisible="{Binding HasTwelveMonthInterest}">
                            <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,4" />
                            <Label Text="Bu planda ödeyeceğin tahmini faiz"
                                   Style="{StaticResource MutedText}" />
                            <!-- Kırılım tek toplama katlanmıyor: ikisi ters
                                 yönde hareket edebiliyor (kartı erken kapatmak
                                 kart faizini düşürürken KMH faizini yükseltir),
                                 tek rakam bunu gizler. -->
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto,Auto"
                                  RowSpacing="5">
                                <Label Text="Kredi kartı" Style="{StaticResource MutedText}" />
                                <Label Grid.Column="1"
                                       Text="{Binding TwelveMonthCardInterest}" />
                                <Label Grid.Row="1" Text="Finansman açığı (KMH)"
                                       Style="{StaticResource MutedText}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding TwelveMonthDeficitInterest}" />
                                <Label Grid.Row="2" Text="Toplam faiz yükü"
                                       FontFamily="OpenSansSemibold" />
                                <Label Grid.Row="2" Grid.Column="1"
                                       Text="{Binding TwelveMonthInterest}"
                                       FontFamily="OpenSansSemibold" />
                            </Grid>
                        </VerticalStackLayout>
                        <Button Text="Dönem dönem incele →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenFutureMonthsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Kısa yollar: sahte modül değil, gerçek bağlantılar -->
                <Border>
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Finansal yapın"
                                   Style="{StaticResource CardHeading}" />
                            <Label Text="{Binding StructureSummary}"
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Gelir ve ödemelerini yönet →"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenCommitmentsCommand}" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Geçmiş dönemler"
                                   Style="{StaticResource CardHeading}" />
                            <Label Text="{Binding HistorySummary}"
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Geçmişi gör →"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenHistoryCommand}" />
                        </VerticalStackLayout>
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Karar denemesi"
                                   Style="{StaticResource CardHeading}" />
                            <Label Text="Planını değiştirmeden 'ya şöyle yapsam?' sorusunu dene."
                                   Style="{StaticResource MutedText}" />
                            <Button Text="Simülatörü aç →"
                                    Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenSimulationCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ TERTIARY ============ -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsDevelopment}">
                    <Button Text="Hesaplama detayı (geliştirme)"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ToggleCalculationDetailsCommand}" />
                    <Border IsVisible="{Binding ShowCalculationDetails}">
                        <Label Text="{Binding CalculationDetails}" FontSize="12" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{StaticResource Error}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
