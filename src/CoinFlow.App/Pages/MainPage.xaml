<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CoinFlow.App.Controls"
             xmlns:models="clr-namespace:CoinFlow.App.Models"
             xmlns:vm="clr-namespace:CoinFlow.App.ViewModels"
             x:Class="CoinFlow.App.Pages.MainPage"
             x:DataType="vm:DashboardViewModel"
             x:Name="PageRoot"
             Title="Ana Sayfa">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,36" Spacing="14">

            <!-- Başlık -->
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2">
                    <Label Text="PLANLA • SİMÜLE ET • KARAR VER"
                           Style="{StaticResource Eyebrow}" />
                    <Label Text="Ana Sayfa" Style="{StaticResource PageTitle}" />
                </VerticalStackLayout>
                <Button Grid.Column="1"
                        Text="Ayarlar"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenSettingsCommand}"
                        Padding="14,8"
                        MinimumHeightRequest="42"
                        VerticalOptions="Center" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}" />

            <!-- §11 UYARILAR — yalnız gerçekten gerekliyse -->
            <VerticalStackLayout Spacing="10"
                                 IsVisible="{Binding HasAlerts}"
                                 BindableLayout.ItemsSource="{Binding Alerts}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardAlert">
                        <Border Style="{StaticResource AlertInfoSurface}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAction}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource DeficitSurface}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border"
                                             Binding="{Binding IsAttention}"
                                             Value="True">
                                    <Setter Property="BackgroundColor"
                                            Value="{StaticResource WarningSurface}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="7">
                                <Label Text="{Binding Title}"
                                       Style="{StaticResource AlertTitle}" />
                                <Label Text="{Binding Message}"
                                       Style="{StaticResource AlertBody}" />
                                <Button Text="{Binding ActionText}"
                                        IsVisible="{Binding HasAction}"
                                        Command="{Binding Action}"
                                        HorizontalOptions="Start"
                                        Padding="16,10"
                                        MinimumHeightRequest="44" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- §12 BOŞ DURUM -->
            <Border IsVisible="{Binding IsEmptyState}"
                    BackgroundColor="{StaticResource SoftSky}"
                    StrokeThickness="0">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Mizan'a hoş geldin"
                           Style="{StaticResource EmptyStateTitle}" />
                    <Label Text="{Binding EmptyStateMessage}"
                           Style="{StaticResource EmptyStateBody}" />
                    <Button Text="{Binding EmptyStateAction}"
                            Command="{Binding OpenEmptyStateCommand}"
                            HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- Ana Sayfa mevcut döneme aittir (I16). Gelecek 12 dönemin
                 rakamları 12 Dönem ekranının, kapanmış dönemlerin rakamları
                 Geçmiş'in; buradaki her sayı donmuş plandan veya gözlemden
                 gelir. Aşağıdaki linkler bilerek rakamsızdır. -->
            <VerticalStackLayout IsVisible="{Binding HasFinancialPlan}"
                                 Spacing="14">

                <!-- Dönem başlığı ve ne kadarının geçtiği -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding CurrentPeriodText}"
                           Style="{StaticResource PageTitle}"
                           FontSize="22" />
                    <Label Text="{Binding PeriodElapsedText}"
                           Style="{StaticResource MutedText}" />
                    <ProgressBar Progress="{Binding PeriodElapsedRatio}"
                                 ProgressColor="{StaticResource ProjectionText}" />
                </VerticalStackLayout>

                <!-- MEVCUT TUTAR — dönem içi gözlem. Snapshot zincirine
                     dokunmaz (I14): plan da, geçmiş de değişmez. -->
                <Border BackgroundColor="{StaticResource SoftSky}"
                        StrokeThickness="0">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Mevcut tutar"
                               Style="{StaticResource CardHeading}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry Text="{Binding CurrentBalanceInput}"
                                   Keyboard="Numeric"
                                   controls:SignedNumericEntry.AllowNegative="True" />
                            <Button Grid.Column="1"
                                    Text="Gözlemi Kaydet"
                                    Padding="16,10"
                                    MinimumHeightRequest="44"
                                    IsEnabled="{Binding CanSaveCurrentBalance}"
                                    Command="{Binding SaveCurrentBalanceCommand}" />
                        </Grid>
                        <Label Text="{Binding LastObservationText}"
                               Style="{StaticResource MutedText}" />
                        <Label Text="Bu bir gözlem: dönem planın ve geçmiş kaydın değişmez. Dönemi kapatırken kullanılacak."
                               Style="{StaticResource MutedText}" />
                    </VerticalStackLayout>
                </Border>

                <!-- PLAN — dönem başında dondurulan taahhüt -->
                <Border>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="PLAN" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding PlanFrozenText}"
                               Style="{StaticResource MutedText}"
                               FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="Dönem sonu"
                                   Style="{StaticResource MutedText}"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding PlannedEndingText}"
                                   Style="{StaticResource SecondaryAmount}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- GİDİŞAT — yalnız gözlem varsa. Rakam uydurulmaz. -->
                <Border IsVisible="{Binding HasObservation}"
                        BackgroundColor="{StaticResource ProjectionSurface}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="GİDİŞAT" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding ObservationDateText}"
                               Style="{StaticResource MutedText}"
                               FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="6">
                            <Label Text="Şu an"
                                   Style="{StaticResource MutedText}" />
                            <Label Grid.Column="1"
                                   Text="{Binding ObservedBalanceText}"
                                   FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="1"
                                   Text="Dönem sonu tahmini"
                                   Style="{StaticResource MutedText}" />
                            <Label Grid.Row="1"
                                   Grid.Column="1"
                                   Text="{Binding ProjectedEndingText}"
                                   Style="{StaticResource SecondaryAmount}" />
                            <Label Grid.Row="2"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding ProjectionBasisText}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="12" />
                            <Label Grid.Row="3"
                                   Text="Plana göre fark"
                                   FontFamily="OpenSansSemibold" />
                            <Label Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding DeviationText}"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="{StaticResource PositiveText}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsDeviationNegative}"
                                                 Value="True">
                                        <Setter Property="TextColor"
                                                Value="{StaticResource DeficitText}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- KALAN — bu dönemden geriye ne var. Bugünkü "Yaklaşan
                     ödemeler" bölümünün yerini alır; ayrı liste tutulmaz. -->
                <Border>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="KALAN" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding RemainingWindowText}"
                               Style="{StaticResource MutedText}"
                               FontSize="12" />

                        <Label Text="Bu dönemde planlı ödemen kalmadı."
                               IsVisible="{Binding HasNoRemainingLines}"
                               Style="{StaticResource EmptyStateBody}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RemainingLines}"
                                             IsVisible="{Binding HasRemainingLines}"
                                             Spacing="9">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:RemainingPaymentLine">
                                    <Grid ColumnDefinitions="64,*,Auto"
                                          RowDefinitions="Auto,Auto">
                                        <Label Text="{Binding Date}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Name}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding Amount}"
                                               FontFamily="OpenSansSemibold" />
                                        <Label Grid.Row="1"
                                               Grid.Column="1"
                                               Grid.ColumnSpan="2"
                                               Text="{Binding Detail}"
                                               Style="{StaticResource MutedText}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding HasRemainingLines}">
                            <Label Text="Toplam"
                                   FontFamily="OpenSansSemibold" />
                            <Label Grid.Column="1"
                                   Text="{Binding RemainingTotalText}"
                                   FontFamily="OpenSansSemibold" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Bu dönemi kapat →"
                        IsVisible="{Binding IsPeriodClosable}"
                        Command="{Binding OpenPeriodReviewCommand}" />

                <Button Text="Bu dönem nasıl oluşuyor →"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenCurrentPeriodDetailCommand}" />

                <!-- Diğer zaman dilimlerine geçişler. Rakam taşımazlar (I16):
                     12 dönem sonu, faiz kırılımı ve geçmiş özeti buradan
                     kalktı; her biri kendi ekranının verisi. -->
                <Border>
                    <VerticalStackLayout Spacing="12">
                        <Button Text="Önümüzdeki 12 dönem →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenFutureMonthsCommand}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Button Text="Geçmiş dönemler →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenHistoryCommand}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Button Text="Gelir ve ödemelerini yönet →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenCommitmentsCommand}" />
                        <BoxView HeightRequest="1" Color="{StaticResource Line}" />
                        <Button Text="Simülatörü aç →"
                                Style="{StaticResource LinkButton}"
                                Command="{Binding OpenSimulationCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ============ TERTIARY ============ -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsDevelopment}">
                    <Button Text="Hesaplama detayı (geliştirme)"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ToggleCalculationDetailsCommand}" />
                    <Border IsVisible="{Binding ShowCalculationDetails}">
                        <Label Text="{Binding CalculationDetails}" FontSize="12" />
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding HasStatus}"
                   TextColor="{StaticResource Error}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
